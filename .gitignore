# macOS
.DS_Store
.AppleDouble
.LSOverrideIcon

# Windows
Thumbs.db
desktop.ini

# Office temp files (Excel/Word lock files created while doc is open)
~$*

# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# JetBrains
.idea/

# ─── Python ──────────────────────────────────────────────────────────────────

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
